# Server (apps/server). Copy to .env; never commit the real one.
DATABASE_URL=postgres://localhost:5432/opportunity_nav
PORT=4317
HOST=127.0.0.1
# Public base URL agents use (A2A agent card, node config), e.g. the Studio's tailnet name.
PUBLIC_URL=http://gg-macstudio:4317

# Node daemon (apps/node). Token is created in the app (Settings → Machines).
OPNAV_SERVER_URL=http://gg-macstudio:4317
OPNAV_NODE_TOKEN=
