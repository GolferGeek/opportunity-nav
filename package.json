{
  "name": "opportunity-nav",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=24" },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc -b",
    "test": "node --test --experimental-strip-types \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
