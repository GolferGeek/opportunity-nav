{
  "name": "@opnav/desktop",
  "version": "0.1.0",
  "private": true,
  "productName": "Opportunity Nav",
  "description": "Opportunity Nav desktop app",
  "author": "Opportunity Nav",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run ensure-electron && npm run build && electron .",
    "dist": "npm run ensure-electron && npm run build && electron-builder --publish never",
    "install:linux": "bash scripts/install-linux.sh",
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "dist:mac": "npm run ensure-electron && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never --mac dmg zip"
  },
  "dependencies": {},
  "devDependencies": {
    "@opnav/node": "*",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "dev.opportunitynav.app",
    "productName": "Opportunity Nav",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development",
      "executableName": "opportunity-nav"
    },
    "electronVersion": "38.8.6",
    "electronDist": "../../node_modules/electron/dist",
    "npmRebuild": false,
    "artifactName": "opportunity-nav-${version}-${arch}.${ext}"
  }
}
